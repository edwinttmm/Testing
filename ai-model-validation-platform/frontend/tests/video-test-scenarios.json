{
  "testScenarios": {
    "happyPath": {
      "name": "Happy Path - Sequential Video Playback",
      "description": "All videos play successfully in sequence with fullscreen",
      "videos": [
        {
          "id": "happy-1",
          "filename": "test_sequence_1.mp4",
          "duration": 5,
          "fps": 30,
          "size": 5242880,
          "url": "/test-videos/test_sequence_1.mp4"
        },
        {
          "id": "happy-2", 
          "filename": "test_sequence_2.mp4",
          "duration": 8,
          "fps": 30,
          "size": 8388608,
          "url": "/test-videos/test_sequence_2.mp4"
        },
        {
          "id": "happy-3",
          "filename": "test_sequence_3.mp4", 
          "duration": 12,
          "fps": 30,
          "size": 12582912,
          "url": "/test-videos/test_sequence_3.mp4"
        }
      ],
      "config": {
        "autoAdvance": true,
        "loopPlayback": false,
        "randomOrder": false,
        "fullscreenEnabled": true,
        "latencyMs": 100
      },
      "expectedBehavior": {
        "totalPlaybackTime": 25000,
        "videoTransitions": 2,
        "fullscreenEntries": 3,
        "completionCallback": true
      }
    },
    
    "errorScenarios": {
      "missingVideos": {
        "name": "Missing Video Files",
        "description": "Handle missing or inaccessible video files gracefully",
        "videos": [
          {
            "id": "missing-1",
            "filename": "nonexistent_video.mp4",
            "duration": 0,
            "fps": 30,
            "size": 0,
            "url": "/test-videos/nonexistent_video.mp4"
          },
          {
            "id": "valid-1",
            "filename": "valid_video.mp4", 
            "duration": 10,
            "fps": 30,
            "size": 10485760,
            "url": "/test-videos/valid_video.mp4"
          }
        ],
        "config": {
          "autoAdvance": true,
          "skipOnError": true,
          "maxRetries": 3
        },
        "expectedBehavior": {
          "errorHandling": true,
          "skipToNextVideo": true,
          "errorCallbacks": 1,
          "continuePlayback": true
        }
      },
      
      "corruptedVideos": {
        "name": "Corrupted Video Files",
        "description": "Handle corrupted or malformed video files", 
        "videos": [
          {
            "id": "corrupt-1",
            "filename": "corrupted_video.mp4",
            "duration": 15,
            "fps": 30,
            "size": 1048576,
            "url": "/test-videos/corrupted_video.mp4",
            "corruptionType": "header_damaged"
          },
          {
            "id": "corrupt-2", 
            "filename": "truncated_video.mp4",
            "duration": 20,
            "fps": 30,
            "size": 512000,
            "url": "/test-videos/truncated_video.mp4",
            "corruptionType": "incomplete_file"
          }
        ],
        "config": {
          "enableRetry": true,
          "retryAttempts": 2,
          "retryDelay": 1000
        },
        "expectedBehavior": {
          "decodeErrors": 2,
          "retryAttempts": 4,
          "fallbackBehavior": true,
          "userNotification": true
        }
      },
      
      "networkIssues": {
        "name": "Network Connectivity Problems",
        "description": "Simulate various network issues during video loading",
        "videos": [
          {
            "id": "slow-load",
            "filename": "slow_loading_video.mp4",
            "duration": 10,
            "fps": 30,
            "size": 52428800,
            "url": "/test-videos/slow_loading_video.mp4",
            "simulatedLatency": 5000
          }
        ],
        "networkConditions": {
          "bandwidth": "1Mbps",
          "latency": 500,
          "packetLoss": 0.02,
          "jitter": 50
        },
        "config": {
          "loadTimeout": 30000,
          "enablePreloading": false
        },
        "expectedBehavior": {
          "loadingIndicator": true,
          "timeoutHandling": true,
          "adaptiveBehavior": true
        }
      }
    },
    
    "userInteraction": {
      "pauseDuringPlayback": {
        "name": "User Pauses During Playback",
        "description": "User pauses video in middle of sequence",
        "videos": [
          {
            "id": "pause-test-1", 
            "filename": "pause_test_video_1.mp4",
            "duration": 15,
            "fps": 30,
            "size": 15728640,
            "url": "/test-videos/pause_test_video_1.mp4"
          },
          {
            "id": "pause-test-2",
            "filename": "pause_test_video_2.mp4", 
            "duration": 20,
            "fps": 30,
            "size": 20971520,
            "url": "/test-videos/pause_test_video_2.mp4"
          }
        ],
        "interactions": [
          {
            "time": 5000,
            "action": "pause",
            "expectedState": "paused"
          },
          {
            "time": 8000, 
            "action": "resume",
            "expectedState": "playing"
          }
        ],
        "expectedBehavior": {
          "pauseRespected": true,
          "resumeFromCorrectTime": true,
          "sequenceContinues": true
        }
      },
      
      "skipVideos": {
        "name": "User Skips Videos",
        "description": "User manually skips through video sequence",
        "videos": [
          {
            "id": "skip-1",
            "filename": "skip_test_1.mp4",
            "duration": 8,
            "fps": 30,
            "size": 8388608,
            "url": "/test-videos/skip_test_1.mp4"
          },
          {
            "id": "skip-2", 
            "filename": "skip_test_2.mp4",
            "duration": 12,
            "fps": 30,
            "size": 12582912,
            "url": "/test-videos/skip_test_2.mp4"
          },
          {
            "id": "skip-3",
            "filename": "skip_test_3.mp4",
            "duration": 6,
            "fps": 30,
            "size": 6291456,
            "url": "/test-videos/skip_test_3.mp4"
          }
        ],
        "interactions": [
          {
            "time": 2000,
            "action": "skipNext",
            "expectedResult": "video-2"
          },
          {
            "time": 4000,
            "action": "skipNext", 
            "expectedResult": "video-3"
          },
          {
            "time": 1000,
            "action": "skipPrevious",
            "expectedResult": "video-2"
          }
        ],
        "expectedBehavior": {
          "navigationWorks": true,
          "progressTracking": true,
          "boundaryHandling": true
        }
      },
      
      "fullscreenToggle": {
        "name": "Fullscreen Toggle During Playback",
        "description": "User toggles fullscreen mode during video playback",
        "videos": [
          {
            "id": "fullscreen-test",
            "filename": "fullscreen_test_video.mp4",
            "duration": 20,
            "fps": 30,
            "size": 20971520,
            "url": "/test-videos/fullscreen_test_video.mp4"
          }
        ],
        "interactions": [
          {
            "time": 3000,
            "action": "enterFullscreen",
            "expectedState": "fullscreen"
          },
          {
            "time": 8000,
            "action": "exitFullscreen", 
            "expectedState": "windowed"
          },
          {
            "time": 12000,
            "action": "enterFullscreen",
            "expectedState": "fullscreen"
          }
        ],
        "expectedBehavior": {
          "fullscreenTransitions": 3,
          "videoNotInterrupted": true,
          "controlsAccessible": true
        }
      }
    },
    
    "browserCompatibility": {
      "chrome": {
        "name": "Chrome Browser Testing",
        "description": "Test all features in Chrome browser environment",
        "userAgent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/91.0.4472.124 Safari/537.36",
        "supportedFeatures": {
