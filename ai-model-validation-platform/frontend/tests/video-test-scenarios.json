      "mixedResolutions": {
        "name": "Mixed Video Resolutions",
        "description": "Test handling of videos with different resolutions in sequence",
        "videos": [
          {
            "id": "res-1",
            "filename": "480p_video.mp4",
            "duration": 5,
            "resolution": "640x480"
          },
          {
            "id": "res-2",
            "filename": "1080p_video.mp4",
            "duration": 5, 
            "resolution": "1920x1080"
          },
          {
            "id": "res-3",
            "filename": "4k_video.mp4",
            "duration": 5,
            "resolution": "3840x2160"
          }
        ],
        "expectedBehavior": {
          "seamlessTransitions": true,
          "adaptiveRendering": true,
          "consistentControls": true
        }
      }
    }
  },
  
  "testConfiguration": {
    "environment": {
      "browser": "jsdom",
      "node": "18.x",
      "testFramework": "jest",
      "testingLibrary": "@testing-library/react"
    },
    "timeouts": {
      "default": 60000,
      "videoLoad": 30000,
      "fullscreenTransition": 5000,
      "userInteraction": 10000,
      "networkOperation": 45000
    },
    "mocks": {
      "videoElement": true,
      "fullscreenAPI": true,
      "performanceAPI": true,
      "networkConditions": true,
      "labJackDevices": true
    },
    "coverage": {
      "threshold": {
        "global": {
          "branches": 80,
          "functions": 85,
          "lines": 90,
          "statements": 90
        }
      },
      "collectFrom": [
        "src/components/SequentialVideoManager.tsx",
        "src/components/VideoAnnotationPlayer.tsx", 
        "src/utils/videoPlaybackManager.ts",
        "src/hooks/useVideoPlayer.ts"
      ]
    },
    "reporting": {
      "formats": ["json", "lcov", "text-summary", "html"],
      "outputPath": "coverage/video-tests",
      "includeMetrics": true,
      "generateSummary": true
    }
  }
}