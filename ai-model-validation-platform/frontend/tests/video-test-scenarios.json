          "memoryEfficiency": true
        }
      },
      
      "unusualFrameRates": {
        "name": "Unusual Frame Rates",
        "description": "Test handling of non-standard frame rates",
        "videos": [
          {
            "id": "fps-1",
            "filename": "unusual_fps_23.976.mp4",
            "duration": 10,
            "fps": 23.976
          },
          {
            "id": "fps-2",
            "filename": "high_fps_120.mp4",
            "duration": 5,
            "fps": 120
          },
          {
            "id": "fps-3",
            "filename": "low_fps_15.mp4", 
