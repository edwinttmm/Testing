            "filename": "very_short_0.1s.mp4",
            "duration": 0.1,
            "fps": 30,
            "frames": 3
          },
          {
            "id": "short-2", 
            "filename": "single_frame.mp4",
            "duration": 0.033,
            "fps": 30,
            "frames": 1
          }
        ],
        "expectedBehavior": {
          "properTransitions": true,
          "noSkipping": true,
          "accurateTiming": true
        }
      },
      
      "veryLongVideos": {
        "name": "Very Long Video Files",
        "description": "Test handling of extremely long video files",
        "videos": [
          {
