        ]
      },
      
      "edge": {
        "name": "Edge Browser Testing",
        "description": "Test all features in Edge browser environment", 
        "userAgent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/91.0.4472.124 Safari/537.36 Edg/91.0.864.59",
        "supportedFeatures": {
          "fullscreenAPI": "requestFullscreen",
          "videoFormats": ["mp4", "webm"],
          "codecs": ["h264", "vp8", "vp9"],
          "autoplay": "user-activation-required"
        },
        "testCases": [
          "modernEdgeFeatures", 
          "legacyEdgeCompatibility",
          "windowsOptimizations"
        ]
      }
    },
    
    "performanceTesting": {
      "largeVideoFiles": {
        "name": "Large Video File Performance",
        "description": "Test performance with large video files",
        "videos": [
          {
            "id": "large-1",
            "filename": "large_video_100mb.mp4",
            "duration": 180,
            "fps": 30,
            "size": 104857600,
            "resolution": "1920x1080",
            "url": "/test-videos/large_video_100mb.mp4"
          },
          {
            "id": "large-2",
            "filename": "large_video_500mb.mp4", 
            "duration": 600,
            "fps": 30,
            "size": 524288000,
            "resolution": "3840x2160",
            "url": "/test-videos/large_video_500mb.mp4"
          }
        ],
        "performanceMetrics": {
          "maxLoadTime": 30000,
          "maxMemoryUsage": 200000000,
          "maxCPUUsage": 80,
          "targetFramerate": 30
        },
        "expectedBehavior": {
          "progressiveLoading": true,
          "memoryManagement": true,
          "smoothPlayback": true
        }
      },
      
      "multipleVideoInstances": {
        "name": "Multiple Video Instances",
        "description": "Test performance with multiple concurrent video players",
        "instances": 5,
        "videosPerInstance": 3,
        "totalVideos": 15,
        "performanceConstraints": {
          "maxTotalMemory": 500000000,
          "maxConcurrentLoads": 3,
          "resourceSharing": true
        },
        "expectedBehavior": {
          "resourceContention": "managed",
          "individualPerformance": "maintained",
          "systemStability": true
        }
      },
      
      "memoryStressTest": {
        "name": "Memory Stress Testing",
        "description": "Test memory usage under stress conditions",
        "scenario": {
          "sequentialLoads": 50,
          "rapidSwitching": true,
          "memoryPressure": true
        },
        "memoryLimits": {
          "warningThreshold": 100000000,
          "criticalThreshold": 200000000,
          "maxAllowed": 300000000
        },
        "expectedBehavior": {
          "memoryLeakPrevention": true,
          "gracefulDegradation": true,
          "cleanupOnDestroy": true
        }
      }
    },
    
    "labJackIntegration": {
      "basicSynchronization": {
        "name": "Basic LabJack Synchronization", 
        "description": "Test basic video-LabJack data synchronization",
        "devices": ["T7"],
        "sampleRate": 1000,
        "channels": ["AIN0", "AIN1", "FIO0"],
        "synchronizationPrecision": 1,
        "testDuration": 30,
        "expectedBehavior": {
          "timestampAccuracy": true,
          "dataCorrelation": true,
          "clockSynchronization": true
        }
      },
      
      "highSpeedAcquisition": {
        "name": "High-Speed Data Acquisition",
        "description": "Test high-speed LabJack data synchronization with video",
        "devices": ["T8"],
        "sampleRate": 50000,
        "channels": ["AIN0", "AIN1", "AIN2", "AIN3"],
        "synchronizationPrecision": 0.1,
        "testDuration": 10,
        "performanceRequirements": {
          "maxLatency": 1,
          "maxJitter": 0.5,
          "dataLossThreshold": 0.001
        },
        "expectedBehavior": {
          "realTimeProcessing": true,
          "bufferManagement": true,
          "precisionTiming": true
        }
      },
      
      "multiDeviceSynchronization": {
        "name": "Multi-Device Synchronization",
        "description": "Synchronize video with multiple LabJack devices",
        "devices": ["T4", "T7", "T8"], 
        "deviceConfigs": {
          "T4": { "sampleRate": 10000, "channels": ["AIN0", "FIO0"] },
          "T7": { "sampleRate": 25000, "channels": ["AIN0", "AIN1", "FIO0", "FIO1"] },
          "T8": { "sampleRate": 50000, "channels": ["AIN0", "AIN1", "AIN2", "AIN3"] }
        },
        "synchronizationChallenges": {
          "clockDrift": true,
          "sampleRateDifferences": true,
          "timestampAlignment": true
        },
        "expectedBehavior": {
          "masterClockSync": true,
          "dataInterleaving": true,
          "coherentTimeline": true
        }
      }
    },
    
    "edgeCases": {
      "veryShortVideos": {
        "name": "Very Short Video Files",
