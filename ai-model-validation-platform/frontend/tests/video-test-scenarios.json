        },
        "testCases": [
          "standardVideoPlayback",
          "fullscreenFunctionality", 
          "codecSupport",
          "autoplayPolicy"
        ]
      },
      
      "firefox": {
        "name": "Firefox Browser Testing",
        "description": "Test all features in Firefox browser environment",
        "userAgent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64; rv:89.0) Gecko/20100101 Firefox/89.0",
        "supportedFeatures": {
          "fullscreenAPI": "mozRequestFullScreen",
          "videoFormats": ["mp4", "webm", "ogg"],
