{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node", "jest", "@testing-library/jest-dom"]
  },
  "include": [
    "src/**/*",
    "src/types/global.d.ts",
    "**/*.test.*",
    "**/*.spec.*",
    "src/tests/**/*"
  ],
  "exclude": [
    "node_modules",
    "build",
    "coverage"
  ]
}