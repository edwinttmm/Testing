# Frontend Development Environment Configuration
REACT_APP_API_URL=http://localhost:8000
REACT_APP_WS_URL=ws://localhost:8000
REACT_APP_VIDEO_BASE_URL=http://localhost:8000
REACT_APP_ENVIRONMENT=development
REACT_APP_DEBUG=true

# Build Configuration
GENERATE_SOURCEMAP=false
SKIP_PREFLIGHT_CHECK=true
TSC_COMPILE_ON_ERROR=true
ESLINT_NO_DEV_ERRORS=true
DISABLE_GPU_CHECK=true

# Development Server
HOST=0.0.0.0
PORT=3000
HTTPS=false
BROWSER=none

# Performance - CRITICAL: Disable all hot reloading and refresh
FAST_REFRESH=false
IMAGE_INLINE_SIZE_LIMIT=10000

# CRITICAL: Disable webpack HMR and WebSocket connections completely
WDS_SOCKET_HOST=
WDS_SOCKET_PORT=
WDS_SOCKET_PATH=

# CRITICAL: Disable ESLint plugin completely
DISABLE_ESLINT_PLUGIN=true

# CRITICAL: Disable TypeScript compilation warnings and errors
TS_NODE_SKIP_PROJECT=true
TS_NODE_TYPE_CHECK=false

# CRITICAL: Disable file watching and polling for stability
CHOKIDAR_USEPOLLING=false
WATCHPACK_POLLING=false

# CRITICAL: Node.js memory optimization
NODE_OPTIONS=--max-old-space-size=4096

# CRITICAL: Disable all error overlays
REACT_APP_OVERLAY=false