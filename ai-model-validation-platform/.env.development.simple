# Simple Development Mode Configuration
# Matches docker-compose.simple.yml PostgreSQL container settings
# Use this configuration for local development with Docker

# ==============================================
# ENVIRONMENT SETTINGS  
# ==============================================
ENVIRONMENT=development
NODE_ENV=development
VRU_ENVIRONMENT=development
APP_ENV=development
VRU_DEBUG=true

# ==============================================
# DATABASE CONFIGURATION - Simple Docker Setup
# ==============================================
# These credentials MUST match docker-compose.simple.yml postgres service
POSTGRES_DB=vru_validation
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password

# Database URLs for backend (internal Docker networking uses 5432, external uses 5433)
DATABASE_URL=postgresql://postgres:password@postgres:5432/vru_validation
AIVALIDATION_DATABASE_URL=postgresql://postgres:password@postgres:5432/vru_validation
VRU_DATABASE_URL=postgresql://postgres:password@postgres:5432/vru_validation
# For external access (localhost connections from host machine)
EXTERNAL_DATABASE_URL=postgresql://postgres:password@localhost:5433/vru_validation

# Database connection settings
VRU_DATABASE_TYPE=postgresql
VRU_DATABASE_NAME=vru_validation
VRU_DATABASE_USER=postgres
VRU_DATABASE_PASSWORD=password
VRU_DATABASE_POOL_SIZE=10
VRU_DATABASE_MAX_OVERFLOW=20
VRU_DATABASE_ECHO=false

# ==============================================
# REDIS CONFIGURATION - Simple Setup
# ==============================================
REDIS_URL=redis://redis:6379
AIVALIDATION_REDIS_URL=redis://redis:6379
VRU_REDIS_URL=redis://redis:6379

# ==============================================
# SECURITY KEYS - Development Only
# ==============================================
SECRET_KEY=development-secret-key-change-for-production
AIVALIDATION_SECRET_KEY=development-secret-key-change-for-production
VRU_SECRET_KEY=development-secret-key-change-for-production
JWT_SECRET_KEY=development-jwt-secret-key-change-for-production
VRU_JWT_ALGORITHM=HS256
VRU_JWT_EXPIRATION=3600

# ==============================================
# API CONFIGURATION
# ==============================================
API_HOST=0.0.0.0
API_PORT=8000
AIVALIDATION_API_HOST=0.0.0.0
AIVALIDATION_API_PORT=8000
VRU_API_HOST=0.0.0.0
VRU_API_PORT=8000

# ==============================================
# CORS CONFIGURATION - Development
# ==============================================
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8001
AIVALIDATION_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8001
VRU_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8001

# ==============================================
# FRONTEND CONFIGURATION
# ==============================================
REACT_APP_API_URL=http://localhost:8001
REACT_APP_WS_URL=ws://localhost:8001
REACT_APP_VIDEO_BASE_URL=http://localhost:8001
REACT_APP_ENVIRONMENT=development
REACT_APP_DEBUG=true
GENERATE_SOURCEMAP=true

# ==============================================
# LOGGING CONFIGURATION
# ==============================================
LOG_LEVEL=DEBUG
VRU_LOG_LEVEL=DEBUG
AIVALIDATION_LOG_LEVEL=DEBUG
VRU_LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# ==============================================
# UPLOAD CONFIGURATION
# ==============================================
UPLOAD_DIR=uploads
VRU_UPLOAD_DIRECTORY=/app/uploads
VRU_MAX_FILE_SIZE_MB=500
MAX_FILE_SIZE=500000000
VRU_ALLOWED_VIDEO_EXTENSIONS=.mp4,.avi,.mov,.mkv,.flv,.webm

# ==============================================
# DOCKER CONFIGURATION
# ==============================================
DOCKER_MODE=true
AIVALIDATION_DOCKER_MODE=true
VRU_DOCKER_MODE=true

# ==============================================
# PERFORMANCE SETTINGS - Development
# ==============================================
UVICORN_WORKERS=1
UVICORN_WORKER_TIMEOUT=300
VRU_MAX_UPLOAD_SIZE=500MB

# ==============================================
# FEATURE FLAGS - Simple Development
# ==============================================
VRU_ENABLE_CVAT_INTEGRATION=false
VRU_ENABLE_REAL_TIME_DETECTION=true
VRU_ENABLE_BATCH_PROCESSING=true
VRU_ENABLE_AUDIT_LOGGING=true
VRU_ENABLE_PERFORMANCE_MONITORING=false

# ==============================================
# HEALTH CHECK CONFIGURATION
# ==============================================
HEALTH_CHECK_ENABLED=true
AIVALIDATION_HEALTH_CHECK_ENABLED=true

# ==============================================
# COMPOSE PROJECT CONFIGURATION
# ==============================================
COMPOSE_PROJECT_NAME=vru-simple-dev
COMPOSE_FILE=docker-compose.simple.yml